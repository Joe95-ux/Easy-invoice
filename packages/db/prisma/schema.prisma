generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
  BUSINESS
  SCALE
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CHECK
  BANK_TRANSFER
  CARD
  OTHER
}

enum EstimateStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum QrCodeType {
  LINK
  PDF
  VCARD
  EVENT
  MENU
  WIFI
  SOCIAL
  COUPON
}

enum QrCodeStatus {
  ACTIVE
  PAUSED
  DELETED
}

enum ReminderKind {
  BEFORE_DUE
  ON_DUE
  OVERDUE
  MANUAL
}

enum ReminderDeliveryStatus {
  SENT
  FAILED
}

enum DocumentType {
  INVOICE
  ESTIMATE
}

enum DocumentRevisionSource {
  CREATE
  EDIT
  RESTORE
  STATUS
  SEND
  VIEWED
  REMINDER
  PAYMENT_CONFIRMATION
}

enum AuditCategory {
  TEAM
  SETTINGS
  DOCUMENT
}

enum NotificationType {
  CLIENT_VIEWED_INVOICE
  CLIENT_VIEWED_ESTIMATE
  ESTIMATE_ACCEPTED
  ESTIMATE_DECLINED
  ESTIMATE_EXPIRED
  PAYMENT_RECEIVED
  INVOICE_OVERDUE
  TEAM_INVITE_RECEIVED
  MEMBER_ROLE_CHANGED
}

enum FollowUpStatus {
  OPEN
  DONE
}

enum FollowUpSource {
  MANUAL
  INVOICE_OVERDUE
  INVOICE_DUE_SOON
  ESTIMATE_EXPIRING
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RecurringInvoiceStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum AuditAction {
  MEMBER_INVITED
  MEMBER_INVITE_CANCELLED
  MEMBER_JOINED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  COMPANY_PROFILE_UPDATED
  COMPANY_LOGO_UPLOADED
  COMPANY_LOGO_REMOVED
  REMINDER_SETTINGS_UPDATED
  DEFAULT_TEMPLATE_CHANGED
  INVOICE_DELETED
  ESTIMATE_DELETED
  CLIENT_DELETED
  PAYMENT_CONFIRMATION_SENT
  PAYMENT_CONFIRMATION_RESENT
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zip       String?
  country   String   @default("US")
  taxId     String?
  logoUrl        String?
  logoBg         String   @default("white")
  logoPlacement  String   @default("watermark")
  brandColor     String?
  currency  String   @default("USD")
  locale    String   @default("en")
  plan      Plan     @default(FREE)
  defaultTemplateId String?
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  /// Stripe Connect Express account that receives invoice card payments.
  stripeConnectedAccountId       String?  @unique
  stripeConnectChargesEnabled    Boolean  @default(false)
  stripeConnectDetailsSubmitted  Boolean  @default(false)
  stripeConnectPayoutsEnabled    Boolean  @default(false)
  remindersEnabled     Boolean  @default(true)
  reminderDaysBefore   Int[]    @default([7, 3])
  reminderOnDueDate    Boolean  @default(true)
  reminderDaysAfter    Int[]    @default([1, 7, 14])
  reminderIncludePdf   Boolean  @default(true)
  paymentReceiptEmailsEnabled Boolean @default(true)
  /// Follow-up emails for open estimates before validUntil.
  estimateRemindersEnabled     Boolean @default(true)
  estimateReminderDaysBefore   Int[]   @default([7, 3])
  estimateReminderOnExpiryDay  Boolean @default(true)
  estimateReminderIncludePdf   Boolean @default(true)
  documentPrefix       String?
  invoiceSequence      Int      @default(0)
  estimateSequence     Int      @default(0)
  receiptSequence      Int      @default(0)
  defaultHourlyRate    Decimal? @db.Decimal(12, 2)
  timerRoundToMinutes  Int      @default(1)
  /// Ordered payment options shown on invoices/estimates, e.g. [{ "label": "PayPal", "value": "pay@co.com" }]
  paymentMethods       Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   CompanyMember[]
  invites   CompanyInvite[]
  clients   Client[]
  invoices  Invoice[]
  estimates Estimate[]
  templates InvoiceTemplate[]
  defaultTemplate InvoiceTemplate? @relation("CompanyDefaultTemplate", fields: [defaultTemplateId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]
  activeTimeTimers ActiveTimeTimer[]
  documentRevisions DocumentRevision[]
  auditEvents       AuditEvent[]
  notifications     Notification[]
  qrCodes           QrCode[]
  followUps         FollowUp[]
  products          Product[]
  recurringInvoices RecurringInvoice[]

  @@index([slug])
}

model CompanyMember {
  id           String    @id @default(cuid())
  companyId    String
  clerkId      String
  email        String
  name         String?
  role         UserRole  @default(MEMBER)
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  notifyClientViewed     Boolean @default(true)
  notifyEstimateResponse Boolean @default(true)
  notifyPaymentReceived  Boolean @default(true)
  notifyInvoiceOverdue   Boolean @default(true)
  notifyTeamChanges      Boolean @default(true)
  celebrateInvoicePaid   Boolean @default(false)

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sentInvites CompanyInvite[] @relation("SentInvites")
  timeEntries TimeEntry[]
  activeTimeTimer ActiveTimeTimer?
  documentRevisions DocumentRevision[]
  invoicePayments InvoicePayment[]
  paymentConfirmationEmails PaymentConfirmationEmail[]
  auditEvents       AuditEvent[]
  notifications     Notification[]
  qrCodes           QrCode[]
  followUps         FollowUp[]
  recurringInvoices RecurringInvoice[]

  @@unique([companyId, clerkId])
  @@index([clerkId])
}

model CompanyInvite {
  id          String    @id @default(cuid())
  companyId   String
  email       String
  role        UserRole  @default(MEMBER)
  token       String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy CompanyMember @relation("SentInvites", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
}

model QrCode {
  id            String     @id @default(cuid())
  companyId     String
  memberId      String?
  /// When set, this QR is the scan-to-pay code for an invoice (usually a LINK to the business's own payment URL).
  invoiceId     String?
  name          String
  type          QrCodeType
  status        QrCodeStatus @default(ACTIVE)
  token         String     @unique
  /// scrypt hash ("salt:derivedKey") when the code is password protected.
  passwordHash  String?
  /// Type-specific payload, e.g. { "url": "https://..." } or vCard/event fields.
  content       Json
  /// Visual settings: colors, dot style, corner radius, logo toggle.
  design        Json
  scanCount     Int        @default(0)
  lastScannedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  member  CompanyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  invoice Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([invoiceId])
}

model Client {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zip       String?
  country   String?
  notes     String?
  defaultHourlyRate Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  estimates Estimate[]
  timeEntries TimeEntry[]
  activeTimeTimers ActiveTimeTimer[]
  followUps FollowUp[]
  recurringInvoices RecurringInvoice[]

  @@index([companyId])
}

/// Reusable product/service for faster invoice and estimate line items.
model Product {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  /// Optional longer text used as the line-item description when set; otherwise `name` is used.
  description      String?
  unitPrice        Decimal  @default(0) @db.Decimal(12, 2)
  defaultQuantity  Decimal  @default(1) @db.Decimal(12, 4)
  unit             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, name])
}

/// Schedule that generates invoices on a cadence (retainers, subscriptions, etc.).
model RecurringInvoice {
  id                 String                 @id @default(cuid())
  companyId          String
  clientId           String
  memberId           String?
  /// Display name, e.g. "Monthly retainer – Acme".
  name               String
  status             RecurringInvoiceStatus @default(ACTIVE)
  frequency          RecurringFrequency
  /// Every N periods (e.g. every 2 weeks when frequency is WEEKLY).
  interval           Int                    @default(1)
  startDate          DateTime               @db.Date
  nextIssueDate      DateTime               @db.Date
  endDate            DateTime?              @db.Date
  maxOccurrences     Int?
  occurrenceCount    Int                    @default(0)
  /// Days after each issue date for the generated invoice due date.
  dueDaysAfterIssue  Int                    @default(14)
  /// When true, newly issued invoices are emailed and marked SENT.
  autoSend           Boolean                @default(false)
  currency           String                 @default("USD")
  taxRate            Decimal                @default(0) @db.Decimal(5, 4)
  discount           Decimal                @default(0) @db.Decimal(12, 2)
  notes              String?
  templateId         String?
  /// Optional invoice this schedule was created from (no FK; source may be deleted).
  sourceInvoiceId    String?
  lastIssuedAt       DateTime?
  lastError          String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  company  Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client   Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  member   CompanyMember?             @relation(fields: [memberId], references: [id], onDelete: SetNull)
  template InvoiceTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  items    RecurringInvoiceLineItem[]
  invoices Invoice[]

  @@index([companyId, status, nextIssueDate])
  @@index([companyId, clientId])
}

model RecurringInvoiceLineItem {
  id               String   @id @default(cuid())
  recurringInvoiceId String
  description      String
  quantity         Decimal  @db.Decimal(12, 4)
  unitPrice        Decimal  @db.Decimal(12, 2)
  sortOrder        Int      @default(0)
  sectionTitle     String?
  sectionSortOrder Int      @default(0)
  createdAt        DateTime @default(now())

  recurringInvoice RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)

  @@index([recurringInvoiceId])
}

model ActiveTimeTimer {
  id          String   @id @default(cuid())
  companyId   String
  memberId    String   @unique
  clientId    String?
  description String
  startedAt   DateTime
  billable    Boolean  @default(true)
  hourlyRate  Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  member  CompanyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  client  Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

model Invoice {
  id            String        @id @default(cuid())
  companyId     String
  clientId      String?
  number        String
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  currency      String        @default("USD")
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  taxRate       Decimal       @default(0) @db.Decimal(5, 4)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  notes         String?
  customFields  Json?
  templateId    String?
  sentAt        DateTime?
  paidAt        DateTime?
  viewedAt      DateTime?
  publicToken   String?       @unique
  sourceEstimateId String?    @unique
  recurringInvoiceId String?
  remindersPaused  Boolean      @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  template  InvoiceTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sourceEstimate Estimate?    @relation("EstimateToInvoice", fields: [sourceEstimateId], references: [id], onDelete: SetNull)
  recurringInvoice RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)
  items     InvoiceLineItem[]
  reminders InvoiceReminder[]
  installments InvoiceInstallment[]
  payments  InvoicePayment[]
  timeEntries TimeEntry[]
  /// Scan-to-pay QRs linked to this invoice (typically one LINK to a payment URL).
  paymentQrCodes QrCode[]
  followUps FollowUp[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([recurringInvoiceId])
}

model InvoiceReminder {
  id           String                 @id @default(cuid())
  invoiceId    String
  kind         ReminderKind
  offsetDays   Int                    @default(0)
  scheduleDate DateTime               @db.Date
  toEmail      String
  status       ReminderDeliveryStatus @default(SENT)
  error        String?
  createdAt    DateTime               @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, kind, offsetDays, scheduleDate])
  @@index([invoiceId])
}

model InvoiceInstallment {
  id        String   @id @default(cuid())
  invoiceId String
  dueDate   DateTime
  amount    Decimal  @db.Decimal(12, 2)
  label     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoicePayment {
  id            String        @id @default(cuid())
  invoiceId     String
  memberId      String?
  receiptNumber String?       @unique
  publicToken   String?       @unique
  amount        Decimal       @db.Decimal(12, 2)
  paidAt        DateTime      @default(now())
  method        PaymentMethod @default(OTHER)
  reference     String?
  note          String?
  /// Stripe Checkout Session id (idempotency for Connect invoice pay).
  stripeCheckoutSessionId String? @unique
  /// Stripe PaymentIntent id on the connected/platform charge.
  stripePaymentIntentId   String? @unique
  createdAt     DateTime      @default(now())

  invoice             Invoice                    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  member              CompanyMember?             @relation(fields: [memberId], references: [id], onDelete: SetNull)
  confirmationEmails  PaymentConfirmationEmail[]

  @@index([invoiceId])
}

model PaymentConfirmationEmail {
  id        String                 @id @default(cuid())
  paymentId String
  memberId  String?
  toEmail   String
  isResend  Boolean                @default(false)
  status    ReminderDeliveryStatus @default(SENT)
  error     String?
  createdAt DateTime               @default(now())

  payment InvoicePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  member  CompanyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([createdAt])
}

model InvoiceLineItem {
  id               String  @id @default(cuid())
  invoiceId        String
  description      String
  quantity         Decimal @default(1) @db.Decimal(12, 4)
  unitPrice        Decimal @default(0) @db.Decimal(12, 2)
  amount           Decimal @default(0) @db.Decimal(12, 2)
  sortOrder        Int     @default(0)
  /// Optional section heading (e.g. "Downstairs"). Null/empty = ungrouped.
  sectionTitle     String?
  /// Order of the section among other sections on the document.
  sectionSortOrder Int     @default(0)

  invoice    Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@index([invoiceId])
}

model TimeEntry {
  id                String    @id @default(cuid())
  companyId         String
  clientId          String?
  memberId          String?
  description       String
  date              DateTime  @db.Date
  durationMinutes   Int
  hourlyRate        Decimal   @db.Decimal(12, 2)
  billable          Boolean   @default(true)
  invoiceId         String?
  invoiceLineItemId String?
  invoicedAt        DateTime?
  externalSource    String?
  externalId        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  member          CompanyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceLineItem InvoiceLineItem? @relation(fields: [invoiceLineItemId], references: [id], onDelete: SetNull)

  @@index([companyId, invoicedAt])
  @@index([companyId, clientId])
  @@index([invoiceId])
  @@unique([companyId, externalSource, externalId])
}

model Estimate {
  id            String         @id @default(cuid())
  companyId     String
  clientId      String?
  number        String
  status        EstimateStatus @default(DRAFT)
  issueDate     DateTime       @default(now())
  validUntil    DateTime?
  currency      String         @default("USD")
  subtotal      Decimal        @default(0) @db.Decimal(12, 2)
  taxRate       Decimal        @default(0) @db.Decimal(5, 4)
  taxAmount     Decimal        @default(0) @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  total         Decimal        @default(0) @db.Decimal(12, 2)
  notes         String?
  customFields  Json?
  templateId    String?
  sentAt        DateTime?
  acceptedAt    DateTime?
  viewedAt      DateTime?
  /// Who accepted via public e-sign (typed name). Null if staff-marked.
  signerName         String?
  /// Optional drawn signature as a PNG data URL.
  signatureDataUrl   String?  @db.Text
  acceptedIp         String?
  acceptedUserAgent  String?
  /// TYPED | DRAWN | STAFF_MARKED
  acceptanceMethod   String?
  publicToken   String?        @unique
  remindersPaused Boolean      @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client   Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  template InvoiceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  convertedInvoice Invoice? @relation("EstimateToInvoice")
  items     EstimateLineItem[]
  reminders EstimateReminder[]
  followUps FollowUp[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

model EstimateReminder {
  id           String                 @id @default(cuid())
  estimateId   String
  kind         ReminderKind
  offsetDays   Int                    @default(0)
  scheduleDate DateTime               @db.Date
  toEmail      String
  status       ReminderDeliveryStatus @default(SENT)
  error        String?
  createdAt    DateTime               @default(now())

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@unique([estimateId, kind, offsetDays, scheduleDate])
  @@index([estimateId])
}

model EstimateLineItem {
  id               String  @id @default(cuid())
  estimateId       String
  description      String
  quantity         Decimal @default(1) @db.Decimal(12, 4)
  unitPrice        Decimal @default(0) @db.Decimal(12, 2)
  amount           Decimal @default(0) @db.Decimal(12, 2)
  sortOrder        Int     @default(0)
  /// Optional section heading (e.g. "Downstairs"). Null/empty = ungrouped.
  sectionTitle     String?
  /// Order of the section among other sections on the document.
  sectionSortOrder Int     @default(0)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
}

model InvoiceTemplate {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  slug      String
  isDefault Boolean  @default(false)
  isSystem  Boolean  @default(false)
  html      String   @db.Text
  css       String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultForCompanies Company[] @relation("CompanyDefaultTemplate")
  invoices Invoice[]
  estimates Estimate[]
  recurringInvoices RecurringInvoice[]

  @@unique([companyId, slug])
}

model DocumentRevision {
  id             String                 @id @default(cuid())
  companyId      String
  documentType   DocumentType
  documentId     String
  revisionNumber Int
  snapshot       Json?
  summary        String
  source         DocumentRevisionSource
  memberId       String?
  metadata       Json?
  createdAt      DateTime               @default(now())

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  member  CompanyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([documentType, documentId, revisionNumber])
  @@index([companyId, documentType, documentId])
  @@index([documentId])
}

model AuditEvent {
  id         String        @id @default(cuid())
  companyId  String
  memberId   String?
  category   AuditCategory
  action     AuditAction
  summary    String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime      @default(now())

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  member  CompanyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, category, createdAt(sort: Desc)])
}

model Notification {
  id        String           @id @default(cuid())
  companyId String
  memberId  String
  type      NotificationType
  title     String
  body      String
  linkUrl   String?
  metadata  Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  member  CompanyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, read, createdAt(sort: Desc)])
  @@index([companyId])
}

/// Billing follow-up checklist items linked to invoices, estimates, and/or clients.
model FollowUp {
  id          String         @id @default(cuid())
  companyId   String
  memberId    String?
  title       String
  notes       String?
  status      FollowUpStatus @default(OPEN)
  dueDate     DateTime?      @db.Date
  sortOrder   Int            @default(0)
  source      FollowUpSource @default(MANUAL)
  /// Stable key for auto-suggestions, e.g. "invoice:overdue:{id}". Null for manual items.
  sourceKey   String?
  clientId    String?
  invoiceId   String?
  estimateId  String?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  member   CompanyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  client   Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  invoice  Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  estimate Estimate?      @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@unique([companyId, sourceKey])
  @@index([companyId, status, sortOrder])
  @@index([companyId, dueDate])
  @@index([invoiceId])
  @@index([estimateId])
}
